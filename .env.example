# 后端默认即可离线演示；不要在本文件填写真实密钥。
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8787
AI_BACKEND_MODE=demo

# Web 与 API 分端口运行时允许的浏览器来源，逗号分隔。
CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# 可选：空间理解 Provider。可选 demo / gateway / agent_plan；留空时按现有凭据推断。
ROOM_ANALYZER_PROVIDER=

# Agent Plan 个人版专属网关。真实 Key 只写在被 Git 忽略的 .env.local。
AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
AGENT_PLAN_API_KEY=
AGENT_PLAN_TEXT_MODEL=doubao-seed-2.0-lite
AGENT_PLAN_IMAGE_MODEL=doubao-seedream-5.0-lite
AGENT_PLAN_TIMEOUT_MS=30000
AGENT_PLAN_LAYOUT_TIMEOUT_MS=90000
AGENT_PLAN_IMAGE_TIMEOUT_MS=90000
AGENT_PLAN_IMAGE_RESPONSE_LIMIT_BYTES=25165824

# 可选：团队自有的 RoomProfile HTTP 网关。与 agent_plan 二选一。
ROOM_ANALYZER_URL=
ROOM_ANALYZER_API_KEY=
ROOM_ANALYZER_TIMEOUT_MS=8000
ROOM_ANALYZER_RESPONSE_LIMIT_BYTES=262144

# JSON 请求体最大 6 MB；AICard 内存态保留 30 分钟。
REQUEST_BODY_LIMIT_BYTES=6000000
CARD_TTL_MS=1800000
MAX_STORED_CARDS=200

# /api/v1 持久化与私有媒体。相对路径从启动命令的当前目录解析。
DATA_DIRECTORY=./data
DATABASE_PATH=./data/ai-corner-renewal.sqlite
PRIVATE_MEDIA_DIRECTORY=./data/private-media
MAX_UPLOAD_BYTES=20000000
TEMPORARY_RETENTION_HOURS=24
MEDIA_ACCESS_TTL_SECONDS=900
LIST_LIMIT_MAX=100

# 真实模型 / 精细 API 接入位（当前故意留空，详见 docs/model-integration.md）。
ASSET_UNDERSTANDING_URL=
ASSET_UNDERSTANDING_API_KEY=
PLANNING_AGENT_URL=
PLANNING_AGENT_API_KEY=
RENDER_EDIT_URL=
RENDER_EDIT_API_KEY=
SEGMENTATION_URL=
SEGMENTATION_API_KEY=

# 可选：本机 Hunyuan3D-2mini（shape-only GLB）。
# 每位开发者在自己的 .env.local 填写专用 Python 与模型缓存路径。
HUNYUAN_PYTHON=
HUNYUAN_CACHE_DIR=
