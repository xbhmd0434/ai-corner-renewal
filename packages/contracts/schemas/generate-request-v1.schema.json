{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-corner-renewal/generate-request-v1.schema.json",
  "title": "GenerateRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "room_input",
    "inspiration_input",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "room_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room_id",
        "image"
      ],
      "properties": {
        "room_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^(?:\\./|/(?!/)|client://|demo://|asset://|https://)\\S+$"
            },
            "data_url": {
              "type": "string",
              "maxLength": 8000000,
              "pattern": "^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/]+={0,2}$"
            },
            "media_type": {
              "enum": [
                "image/jpeg",
                "image/png",
                "image/webp"
              ]
            }
          },
          "anyOf": [
            {
              "required": [
                "reference"
              ]
            },
            {
              "required": [
                "data_url"
              ]
            }
          ]
        },
        "reference_width_cm": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 40,
          "maximum": 400
        },
        "quality_hint": {
          "enum": [
            "clear",
            "blurry",
            "partial"
          ]
        }
      }
    },
    "inspiration_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspiration_id",
        "source_type",
        "style_key"
      ],
      "properties": {
        "inspiration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "source_type": {
          "enum": [
            "demo",
            "authorized_public",
            "user_owned"
          ]
        },
        "style_key": {
          "enum": [
            "warm",
            "compact",
            "green"
          ]
        }
      }
    },
    "constraints": {
      "$ref": "#/$defs/UserConstraints"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analysis_mode": {
          "enum": [
            "auto",
            "demo",
            "live"
          ],
          "default": "auto"
        },
        "include_trace": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "$defs": {
    "UserConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_cny",
        "hard_constraints",
        "soft_preferences",
        "goals"
      ],
      "properties": {
        "budget_cny": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "hard_constraints": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "no_drilling",
              "keep_desk",
              "keep_chair",
              "pet_safe"
            ]
          }
        },
        "soft_preferences": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
